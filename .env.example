# Copy to .env.local (gitignored) or set these in the host's build and function settings.

# Public origin of the deployed site, no trailing slash. Read at build time: canonical link,
# og:url, absolute og:image / twitter:image, the robots.txt sitemap line and sitemap.xml.
VITE_SITE_URL=https://www.example.com

# Footer legal links. Empty: the pages shipped as public/privacy.html and public/terms.html.
VITE_PRIVACY_URL=
VITE_TERMS_URL=

# Footer "Follow" column. Each link renders only when its URL is set.
VITE_INSTAGRAM_URL=
VITE_X_URL=
VITE_YOUTUBE_URL=

# Contact delivery, read by the serverless function at request time (server/contact.ts).
# Never prefix these with VITE_: that would inline them into the browser bundle.
# Either Resend (transactional mail) ...
RESEND_API_KEY=
CONTACT_TO=hello@example.com
CONTACT_FROM=IONA website <no-reply@example.com>
# ... or any JSON webhook (Slack, Make, Zapier, a CRM). Resend wins when both are set.
CONTACT_WEBHOOK_URL=
